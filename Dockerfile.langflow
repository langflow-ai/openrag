# syntax=docker/dockerfile:1.4
FROM langflowai/langflow:base-0.11.3

# Install uv and pre-create the Langflow data directory.
# The base image already runs as uid=1000 and owns /app, so no root or chown needed.
RUN pip install uv \
    && mkdir -p /app/langflow-data

RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.10.0 \
    torchvision==0.25.0 \
    docling \
    openai \
    langchain-openai \
    anthropic \
    langchain-anthropic \
    google-generativeai \
    langchain-google-genai \
    langchain-ollama \
    langchain-azure-ai \
    opensearch-py \
    langfuse \
    "ibm-watsonx-ai>=1.3.1,<2.0.0" \
    "langchain-ibm~=1.1.0"

# Patch a bug in the base image's vendored `lfx` package: the "Language
# Model" component's real Azure AI Foundry chat/completion calls reuse
# AZURE_AI_FOUNDRY_FETCH_TIMEOUT — a 10s timeout meant for the lightweight
# credential-validation /models probe — as their request_timeout (see
# lfx/base/models/unified_models/instantiation.py, the "Azure AI Foundry"
# branch: `kwargs["request_timeout"] = AZURE_AI_FOUNDRY_REQUEST_TIMEOUT`).
# 10s is too short for a real completion under normal Azure latency, so
# chat/nudges flows using Azure AI Foundry fail with
# "Error building Component Language Model: Request timed out." even when
# credentials and api-version are correct. Decouple the two: keep the 10s
# probe timeout as-is, give the real request timeout its own, longer
# default, overridable via the AZURE_AI_FOUNDRY_REQUEST_TIMEOUT env var.
#
# Pinned to langflow base-0.11.3. Fails the build loudly (not silently
# no-op) if upstream lfx changes this, per the assert below.
RUN python <<'EOF'
import pathlib

import lfx.base.models.model_utils as m

path = pathlib.Path(m.__file__)
src = path.read_text()

old = (
    "AZURE_AI_FOUNDRY_FETCH_TIMEOUT = 10.0\n"
    "# Shared wall-clock bound for Foundry HTTP (discovery) and SDK (validate/get_llm).\n"
    "AZURE_AI_FOUNDRY_REQUEST_TIMEOUT = AZURE_AI_FOUNDRY_FETCH_TIMEOUT\n"
)
if old not in src:
    raise SystemExit(
        "lfx model_utils.py's AZURE_AI_FOUNDRY_FETCH_TIMEOUT/"
        "AZURE_AI_FOUNDRY_REQUEST_TIMEOUT block no longer matches the "
        "expected source; update or drop this Dockerfile.langflow patch"
    )

new = (
    "AZURE_AI_FOUNDRY_FETCH_TIMEOUT = 10.0\n"
    "# Real chat/completion requests get their own, longer timeout — a\n"
    "# validation-probe timeout is too tight for actual inference latency.\n"
    "# Override via the AZURE_AI_FOUNDRY_REQUEST_TIMEOUT env var.\n"
    "import os as _os\n"
    'AZURE_AI_FOUNDRY_REQUEST_TIMEOUT = float(_os.getenv("AZURE_AI_FOUNDRY_REQUEST_TIMEOUT", "120"))\n'
)

new_src = src.replace(old, new, 1)
if new_src == src:
    raise SystemExit("replace of the timeout block was a no-op; investigate")
path.write_text(new_src)

import importlib.util

cache_file = pathlib.Path(importlib.util.cache_from_source(str(path)))
cache_file.unlink(missing_ok=True)

print(f"Patched {path}")
EOF

# Build-time functional self-test: fail the build if the patch didn't
# actually decouple the two timeouts.
RUN python <<'EOF'
import importlib

import lfx.base.models.model_utils as m

if m.AZURE_AI_FOUNDRY_REQUEST_TIMEOUT == m.AZURE_AI_FOUNDRY_FETCH_TIMEOUT:
    raise SystemExit(
        "Dockerfile.langflow patch did not take effect; "
        f"REQUEST_TIMEOUT still equals FETCH_TIMEOUT ({m.AZURE_AI_FOUNDRY_FETCH_TIMEOUT})"
    )
print(
    f"Verified: fetch_timeout={m.AZURE_AI_FOUNDRY_FETCH_TIMEOUT}, "
    f"request_timeout={m.AZURE_AI_FOUNDRY_REQUEST_TIMEOUT}"
)
EOF

COPY flows/ /app/flows/
COPY custom_components/ /app/custom_components/

# Copy the entrypoint before switching to root so the COPY runs as uid=1000
# (which owns /app), then switch to root so the entrypoint can correct
# bind-mount permissions at runtime before dropping back to uid=1000.
COPY --chmod=755 scripts/langflow-entrypoint.py /usr/local/bin/langflow-entrypoint
COPY flows/component_index.json /app/component_index.json
USER root
# component_index.json is not a flow: Langflow scans /app/flows/ and crashes
# trying to load it as one. Drop the copy under flows/ and keep only the one at
# LANGFLOW_COMPONENTS_INDEX_PATH below. Must run after USER root — as uid=1000
# the rm fails on the /app/flows/ directory.
RUN rm -f /app/flows/component_index.json
ENV LANGFLOW_SSRF_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
ENV LANGFLOW_LOG_TRACE_LOCALS=false
ENV LANGFLOW_BLOCK_CODE_INTERPRETER_COMPONENTS=true
ENV LANGFLOW_COMPONENTS_PATH=/app/custom_components
ENV LANGFLOW_COMPONENTS_INDEX_PATH=/app/component_index.json
ENV LANGFLOW_ALLOW_CUSTOM_COMPONENTS=false

EXPOSE 7860

ENTRYPOINT ["langflow-entrypoint"]
CMD ["python", "-m", "langflow", "run", "--host", "0.0.0.0", "--port", "7860"]
