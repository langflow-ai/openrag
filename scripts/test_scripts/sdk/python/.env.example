# BomaRAG SaaS smoke-test configuration.
# Copy to .env and fill in your deployment's values.

# Base URL of the BomaRAG deployment (no trailing slash needed)
BOMARAG_URL=https://your-bomarag-instance.example.com

# IBM SaaS credentials — sent as X-Username / X-Api-Key headers
BOMARAG_USERNAME=your-user@example.com
BOMARAG_API_KEY=your-api-key
