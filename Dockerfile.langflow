# syntax=docker/dockerfile:1.4

# -----------------------------------------------------------------------------
# Stage: lxml-build
# lxml's PyPI wheels statically bundle their own libxml2 (2.14.6 as of lxml
# 6.1.3), which is vulnerable to CVE-2026-86140 (fixed upstream in 2.15.4).
# Rebuild lxml from source so it links against RHEL's patched system libxml2
# (2.12.5-10.el10_2.4) instead.
#
# TODO: Remove the CVE-2026-74860 / CVE-2026-86140 workarounds once the
# langflowai/langflow base image ships both fixes. Check with:
#   rpm -q libxml2   -> 2.12.5-10.el10_2.4 or later
#   python -c "import lxml.etree as e; print(e.LIBXML_VERSION)"   -> (2, 15, 4) or later
# Then delete: this lxml-build stage, the libxml2 update and libxslt install in
# the runtime root step, and the lxml wheel swap after the pip install.
# -----------------------------------------------------------------------------
FROM langflowai/langflow:base-1.12.3 AS lxml-build

USER root
RUN microdnf install -y \
    gcc \
    libxml2-devel \
    libxslt-devel \
    python3.14-devel \
    && microdnf clean all \
    && rm -rf /var/cache/yum
# Build the same lxml version the base image ships so only the linkage changes.
RUN pip wheel --no-cache-dir --no-deps --no-binary lxml -w /wheels \
    "lxml==$(pip show lxml | awk '/^Version:/ {print $2}')"

# -----------------------------------------------------------------------------
# Stage: runtime
# -----------------------------------------------------------------------------
FROM langflowai/langflow:base-1.12.3

# Install uv, then pre-create the Langflow data directory as root.
# Langflow 1.12's base image runs as uid=1000, but /app itself is not writable.
# Upgrade pip first to patch CVE-2026-8643 (fixed in 26.1.2) in the base image.
RUN pip install --no-cache-dir --upgrade "pip>=26.1.2" \
    && pip install --no-cache-dir uv

USER root
# Patch base-image CVEs in system packages:
#   libxml2 >= 2.12.5-10.el10_2.4: CVE-2026-74860, CVE-2026-86140. libxslt is
#     the runtime library for the source-built lxml. TODO: remove (see lxml-build).
#   expat >= 2.7.3-1.el10_2.5: CVE-2026-66046, CVE-2026-93990
#   npm 12.2.1 (bundles brace-expansion 5.0.12): CVE-2026-102276, CVE-2026-102278
RUN microdnf install -y 'libxml2 >= 2.12.5-10.el10_2.4' \
    && microdnf install -y libxslt \
    && microdnf install -y 'expat >= 2.7.3-1.el10_2.5' \
    && npm install -g --no-audit --no-fund npm@12.2.1 \
    && npm cache clean --force \
    && microdnf clean all \
    && rm -rf /var/cache/yum \
    && mkdir -p /app/langflow-data \
    && chmod 0777 /app/langflow-data
USER 1000

# Minimum versions that patch base-image CVEs:
#   pypdf 6.19.0: CVE-2026-102998, CVE-2026-102999, CVE-2026-103000
#   pyjwt 2.14.0: CVE-2026-102266, CVE-2026-102267, CVE-2026-102268,
#     CVE-2026-102271, CVE-2026-102272, CVE-2026-102273
#   urllib3 2.8.0: CVE-2026-97687, CVE-2026-97689
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.13.0 \
    torchvision==0.28.0 \
    "transformers>=5.10.1,<6.0.0" \
    "docling-core<3.0.0" \
    "pypdf>=6.19.0,<7.0.0" \
    "pyjwt>=2.14.0,<3.0.0" \
    "urllib3>=2.8.0,<3.0.0" \
    openai \
    langchain-openai \
    anthropic \
    langchain-anthropic \
    google-generativeai \
    langchain-google-genai \
    langchain-ollama \
    opensearch-py \
    langfuse \
    "ibm-watsonx-ai>=1.3.1,<2.0.0" \
    "langchain-ibm~=1.1.0"

# Swap in the source-built lxml last so no later install restores the bundled
# wheel. TODO: remove (see lxml-build).
COPY --from=lxml-build /wheels /tmp/lxml-wheels
RUN pip install --no-cache-dir --no-deps --force-reinstall /tmp/lxml-wheels/lxml-*.whl

COPY custom_components/ /app/custom_components/

# Switch to root so the entrypoint can correct bind-mount permissions at
# runtime before dropping back to uid=1000.
COPY --chmod=755 scripts/langflow-entrypoint.py /usr/local/bin/langflow-entrypoint
COPY scripts/patch_langflow_openrag_bundle.py /tmp/patch_langflow_openrag_bundle.py
COPY scripts/langflow_sitecustomize.py /tmp/langflow_sitecustomize.py
USER root
RUN python3 /tmp/patch_langflow_openrag_bundle.py
# Preload openai.resources at `langflow run` startup to avoid a concurrent
# lazy-import deadlock when flows build their components (#2436).
RUN install -m 644 /tmp/langflow_sitecustomize.py \
    "$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')/sitecustomize.py"
ENV LANGFLOW_SSRF_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
ENV LANGFLOW_LOG_TRACE_LOCALS=false
ENV LANGFLOW_LOG_FORMAT=key_value
ENV LANGFLOW_BLOCK_CODE_INTERPRETER_COMPONENTS=true
ENV LANGFLOW_COMPONENTS_PATH=/app/custom_components
ENV LANGFLOW_ALLOW_CUSTOM_COMPONENTS=false
ENV LANGFLOW_DANGEROUSLY_ALLOW_MULTI_WORKER_WITHOUT_SHARED_QUEUE=true
ENV LANGFLOW_DISABLE_TRACK_APIKEY_USAGE=true


# CWE-426 fix: explicitly set PATH so system-owned directories are always resolved
# first. App venv and ubi python dirs are appended last so they cannot shadow system binaries.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/app/.venv/bin:/opt/app-root/bin:/opt/app-root/src/bin:/opt/app-root/src/.local/bin

EXPOSE 7860

ENTRYPOINT ["langflow-entrypoint"]
CMD ["python", "-m", "langflow", "run", "--host", "0.0.0.0", "--port", "7860"]
